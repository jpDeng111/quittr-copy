DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
MELIUS_MODEL=qwen3.7-plus
# 每日小课堂复用同一套 coding plan 凭据，模型与超时可单独指定
LESSON_MODEL=qwen3.7-plus
LESSON_TIMEOUT_MS=60000
PORT=3000
# 本机/局域网直连：0.0.0.0；经本机 Caddy 对外提供 HTTPS：127.0.0.1
HOST=0.0.0.0
# 外网 HTTPS 部署时填写，例如 https://quittr.example.com；局域网开发留空
PUBLIC_ORIGIN=
# 只有在本机可信反向代理之后才设为 true
TRUST_PROXY=false
ALLOW_REGISTRATION=true
# 可选绝对路径，默认 ./data；SQLite 数据库必须在本机磁盘上
QUITTR_DATA_DIR=
